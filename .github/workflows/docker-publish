name: Build and Push Docker Image

on:
  push:
    branches:
      - main # Запускать пайплайн при пуше в ветку main

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3


      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # 4. Сборка и отправка образа
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: . # Путь к директории с Dockerfile (точка означает корень репозитория)
          file: ./Dockerfile # Явное указание файла (опционально, если он называется Dockerfile)
          push: true # Флаг для автоматической отправки (push) после сборки
          tags: |
            ${{ secrets.DOCKER_USERNAME }}/my-app:latest
            ${{ secrets.DOCKER_USERNAME }}/my-app:${{ github.sha }} # Тег с хешем коммита для версионирования
