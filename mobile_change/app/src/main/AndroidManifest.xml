<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkipperProject">
        


        <activity android:name=".MobilePackage.CommonUI.FirstSteps.MainScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MobilePackage.CommonUI.FirstSteps.LoginActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.FirstSteps.CreateAccountActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.Profiles.MentorProfileActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.FirstSteps.FillingAccountActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.FindingMentorActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.Profiles.MentorsPageActivity"
            android:exported="true" />


        <activity android:name=".MobilePackage.CommonUI.Tools.TestActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.NotificationActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.Profiles.MentiProfileActivity"
            android:exported="true" />

        <activity android:name=".MobilePackage.CommonUI.Profiles.MentiPageActivity"
            android:exported="true" />


    </application>

</manifest>
